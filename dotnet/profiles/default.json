{
  "name": "default",
  "description": "Built-in defaults: rename identifying names and ids, keep electrical data intact.",
  "preserveNames": [],
  "redactTerms": [],
  "redactionText": "REDACTED",
  "cim": {
    "anonymizeIds": true,
    "anonymizeExternalReferences": true,
    "preserveIdPatterns": [],
    "anonymizeNames": true,
    "anonymizeMrids": true,
    "anonymizeDescriptions": true,
    "stripComments": true,
    "replaceHeaders": true,
    "keepTypeHints": false,
    "vocabularyMinCount": 20,
    "sensitiveClasses": [
