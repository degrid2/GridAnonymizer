      "SolarGeneratingUnit": "GU",
      "EnergyConsumer": "LOAD",
      "ConformLoad": "LOAD",
      "NonConformLoad": "LOAD",
      "StationSupply": "AUX",
      "EnergySource": "SRC",
      "ExternalNetworkInjection": "INJ",
      "EquivalentInjection": "EQI",
      "EquivalentBranch": "EQB",
      "ShuntCompensator": "SH",
