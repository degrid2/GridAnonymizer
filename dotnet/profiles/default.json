      "SubGeographicalRegion",
      "Line",
      "ControlArea",
      "Organisation",
      "OperatingCompany",
      "GeneratingUnit",
      "ThermalGeneratingUnit",
      "HydroGeneratingUnit",
      "NuclearGeneratingUnit"
    ],
    "numericNameClasses": [
      "VoltageLevel",
      "BaseVoltage"
    ],
    "classPrefixes": {
