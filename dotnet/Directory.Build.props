<Project>
  <!-- Shared settings for every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1031 (catch general exceptions) and CA1305 (culture) are noisy for a CLI that uses invariant globalization. -->
    <NoWarn>$(NoWarn);CA1031;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1002;CA2227;CA1819;CA1303;CA1515;CA1716;CA1720;CA1724;CA1848;CA1860;CA1865;CA1866;CA1847;CA1834;CA2249;CA1822;CA1854;CA1851;CA1859</NoWarn>

    <Version>2.0.0</Version>
    <Authors>GridAnonymizer contributors</Authors>
    <Copyright>Copyright (c) GridAnonymizer contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/svuriti2/GridAnonymizer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/svuriti2/GridAnonymizer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cim;cgmes;psse;power-systems;anonymization;privacy;iec61970</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
